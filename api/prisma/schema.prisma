generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The @map/@@map entries point to the original Spanish names in the DB:
// the code is in English but the database does not change (see the English
// code migration in git history, commit 260291d). Enum VALUES are not
// migrated either: they are persisted domain codes visible in portal URLs.

// A_CONVENIR covers listings that do not state a schedule (common in press
// imports): they used to be stored as TIEMPO_COMPLETO, which was made-up
// data.
enum JobType {
  DIARIA
  TIEMPO_COMPLETO
  MEDIA_JORNADA
  POR_CONTRATO
  PASANTIA
  FREELANCE
  A_CONVENIR

  @@map("TipoJornada")
}

// Bolivia's 9 departments (for filtering by area).
enum Department {
  LA_PAZ
  SANTA_CRUZ
  COCHABAMBA
  ORURO
  POTOSI
  CHUQUISACA
  TARIJA
  BENI
  PANDO

  @@map("Departamento")
}

// Common categories in the Bolivian "chamba" (odd-job) market.
enum Category {
  VENTAS
  GASTRONOMIA
  CONSTRUCCION
  LIMPIEZA
  CUIDADO_PERSONAS
  TRANSPORTE
  ADMINISTRACION
  TECNOLOGIA
  EDUCACION
  SALUD
  BELLEZA
  SEGURIDAD
  AGROPECUARIA
  MECANICA
  MARKETING_DISENO
  OTRO

  @@map("Categoria")
}

// VENCIDO is not persisted: an ad with expiresAt in the past is treated as
// expired on read, and the hourly cleanup (AdsCleanupService) deletes it.
enum AdStatus {
  ACTIVO
  DADO_DE_BAJA

  @@map("EstadoAnuncio")
}

enum ReportReason {
  SPAM
  FRAUDE
  CONTENIDO_INAPROPIADO
  OTRO

  @@map("MotivoReporte")
}

enum ReportStatus {
  PENDIENTE
  ATENDIDO
  DESCARTADO

  @@map("EstadoReporte")
}

enum NotificationType {
  CHAT_INICIADO
  NUEVA_REVIEW
  ANUNCIO_VENCIDO
  NUEVO_ANUNCIO

  @@map("TipoNotificacion")
}

// Events recorded by the system audit trail (auditing, read-only).
enum TraceType {
  LOGIN
  LOGOUT
  REGISTER
  EMAIL_VERIFIED
  ADMIN_CREATED
  ROLE_UPDATED
  USER_DELETED
  AD_CREATED
  AD_UPDATED
  AD_VIEWED
  AD_IMPORTED
  AD_UNPUBLISHED
  AD_REPUBLISHED
  AD_DELETED
  REPORT_CREATED
  REPORT_RESOLVED
  REPORT_DELETED
  REVIEW_CREATED
  REVIEW_UPDATED
  REVIEW_DELETED
  USER_UPDATED
  TRACE_DELETED
}

// Outcome of the audited operation (failed attempts are logged too).
enum TraceResult {
  OK
  ERROR
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  emailVerified      Boolean   @default(false)
  // Nullable: accounts created with Google have no local password.
  password           String?
  name               String    @map("nombre")
  phone              String?   @map("telefono")
  googleId           String?   @unique
  // The only distinction between users: access to the admin panel.
  isAdmin            Boolean   @default(false) @map("esAdmin")
  ads                Ad[]
  interests          Interest[]
  reviewsWritten     Review[]  @relation("ReviewsEscritas")
  reviewsReceived    Review[]  @relation("ReviewsRecibidas")
  reports            Report[]
  notifications      Notification[]
  alerts             JobAlert[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Email verification token (single use, with expiry).
model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Password reset token (single use, with expiry).
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("TokenRestablecimiento")
}

model Ad {
  id           String    @id @default(uuid())
  // Short job title. Required; ads predating the migration were backfilled
  // with the first sentence of their description.
  title        String    @map("titulo")
  description  String    @map("descripcion")
  // Candidate requirements, kept separate from the job description.
  requirements String?   @map("requisitos")
  // Nullable only because of pre-migration ads; the API requires it on create.
  location     String?   @map("ubicacion")
  // Free text to guide the applicant ("frente al mercado Los Pozos"): unlike
  // location it is not used for filtering, only displayed.
  locationReference String? @map("referenciaUbicacion")
  // Department and category for filtering (nullable due to pre-migration data).
  department   Department? @map("departamento")
  category     Category?   @map("categoria")
  // Coordinates of the pin chosen on the map (optional).
  latitude     Float?    @map("latitud")
  longitude    Float?    @map("longitud")
  schedule     String?   @map("horario")
  // Nullable: the CSV import allows listings without a salary ("a convenir").
  // With salaryMax the pair is a range ("Bs 3.500 a 4.500"); alone, it is a
  // fixed amount. salary is always the lower bound of the range.
  salary       Decimal?  @map("salario") @db.Decimal(12, 2)
  salaryMax    Decimal?  @map("salarioMax") @db.Decimal(12, 2)
  // Main phone (shown first and used for WhatsApp) and the extra ones: press
  // listings often publish two or three numbers.
  phone        String    @map("telefono")
  extraPhones  String[]  @default([]) @map("telefonosExtra")
  jobType      JobType   @map("tipoJornada")
  status       AdStatus  @default(ACTIVO) @map("estado")
  // Manual priority set from the panel: the highest goes first in the public
  // listing and in the panel, above any relevance criteria. 0 = normal.
  priority     Int       @default(0) @map("prioridad")
  durationDays Int       @default(3) @map("duracionDias")
  expiresAt    DateTime  @map("expiraEn")
  reports      Report[]
  notifications Notification[]
  visits       Visit[]
  reviews      Review[]
  interests    Interest[]
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("Anuncio")
}

// A user's review of someone else's ad (at most one per ad). The ad owner is
// stored denormalized for their overall rating.
model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String   @map("comentario")
  author    User     @relation("ReviewsEscritas", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @map("autorId")
  owner     User     @relation("ReviewsRecibidas", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String   @map("duenoId")
  // SetNull: when the ad is deleted (expired cleanup) the review is unlinked
  // but kept — the owner's rating is not lost.
  ad        Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)
  adId      String?  @map("anuncioId")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, adId])
}

// A user's interest in someone else's ad: recorded on contact
// (Chatear/Llamar) and feeds "anuncios de tu interés" and the counts the
// owner sees.
model Interest {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("usuarioId")
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      String   @map("anuncioId")
  // true when they also made contact (Chatear/Llamar); triggers the owner notice.
  contacted Boolean  @default(false) @map("contacto")
  createdAt DateTime @default(now())

  @@unique([userId, adId])
  @@index([adId])
  @@map("Interes")
}

// A TRABAJADOR's subscription to new listings by criteria. A null field means
// "any". Replaces the mass notice: only workers whose alert matches the newly
// published ad are notified.
model JobAlert {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  department Department? @map("departamento")
  category   Category?   @map("categoria")
  createdAt  DateTime    @default(now())

  @@index([department, category])
  @@index([userId])
  @@map("AlertaEmpleo")
}

// In-app notification for authenticated users. Ad expiry notices are generated
// on read (lazy, no cron); the rest at the time of the event.
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @map("tipo")
  message   String           @map("mensaje")
  read      Boolean          @default(false) @map("leida")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  ad        Ad?              @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      String?          @map("anuncioId")
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("Notificacion")
}

// Spam/abuse report on an ad. The ad's visibility only changes by ADMIN
// decision (there is no auto-hiding).
model Report {
  id         String       @id @default(uuid())
  reason     ReportReason @map("motivo")
  comment    String?      @map("comentario")
  status     ReportStatus @default(PENDIENTE) @map("estado")
  ad         Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId       String       @map("anuncioId")
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  createdAt  DateTime     @default(now())

  @@unique([adId, reporterId])
  @@map("Reporte")
}

// Visit to an ad's detail page (recorded from the portal). The relation is
// optional (SetNull) so visit metrics survive the ad's hard delete.
model Visit {
  id        String   @id @default(uuid())
  ad        Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)
  adId      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adId])
}

// Page view on the portal (general site visit, not only to ads). userId is
// stored only if the visit came with a signed-in session: it feeds the
// last-visit and time-on-site stats per registered user. No FK on purpose:
// the metric survives the user's deletion and anonymous visits stay
// anonymous (userId null).
model PageView {
  id        String   @id @default(uuid())
  path      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Click on a "Sitios de interés" card (Grupo CorpSC companies on the home
// page). Recorded from the portal when the visitor opens a sister company's
// site; feeds the access table in the admin panel. Anonymous: we only store
// which site was opened and when (no personal data).
model SiteClick {
  id        String   @id @default(uuid())
  // Company identifier (slug from lib/companies), e.g. "corpsc".
  company   String
  // Display name at click time (denormalized for the panel).
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([company])
}

// System audit trail: events relevant for auditing. The actor is
// denormalized (email) so the trail survives the user's deletion.
// IP and user-agent are captured automatically from the request (see
// RequestContextMiddleware); resource points to the affected resource
// ("ad:<id>", "user:<id>", "review:<id>", "report:<id>").
model Trace {
  id          String      @id @default(uuid())
  type        TraceType
  description String
  actorId     String?
  actorEmail  String?
  ip          String?
  userAgent   String?
  // Country (ISO-2) resolved via geo-IP or CDN header, and the request's
  // source/origin (utm_source or the Referer host). Both optional.
  country     String?
  source      String?
  resource    String?
  result      TraceResult @default(OK)
  // Milliseconds from the start of the request until the event occurred.
  durationMs  Int?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([actorEmail])
}

// ——— System error log ("Actividad del Sitio" panel) ———

enum ErrorSeverity {
  WARNING
  ERROR
  CRITICAL
}

enum ErrorStatus {
  NEW
  RESOLVED
}

// Errors captured by the global filter (5xx) and background processes. The
// admin can mark them as resolved from the panel.
model ErrorLog {
  id        String        @id @default(uuid())
  // Source: "api", "cron", "mail"...
  service   String
  message   String
  stack     String?
  path      String?
  severity  ErrorSeverity @default(ERROR)
  status    ErrorStatus   @default(NEW)
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}
