NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Google Sign-In se configura SOLO en el backend (GOOGLE_CLIENT_ID):
# el frontend pide el Client ID al API en runtime (GET /auth/google-client).

# ─── Analítica del grupo ───
# Sin estas dos variables, /api/hub-track no envía nada: es lo que se quiere en
# local y en las vistas previas, para no ensuciar las cifras del hub.
# La clave se emite en el hub (Ajustes → Proyectos) y se enseña una sola vez.
HUB_URL=https://hub.corpsc.com/api
HUB_API_KEY=
